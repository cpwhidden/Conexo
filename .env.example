# Database
CONEXO_DATABASE_URL=postgresql+asyncpg://conexo:conexo@localhost:5432/conexo

# JWT
CONEXO_JWT_SECRET_KEY=change-me-in-production

# Google OAuth (get from Google Cloud Console)
CONEXO_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Google Cloud Storage
CONEXO_GCS_BUCKET_NAME=conexo-videos
# Leave empty to use Application Default Credentials, or set path to service account key
CONEXO_GCS_CREDENTIALS_PATH=

# CORS
# Comma-separated list of allowed origins
CONEXO_CORS_ORIGINS=http://localhost:5173
